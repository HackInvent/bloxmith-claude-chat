{
  "kind": "claude_chat",
  "title": "Claude Chat",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "instruction",
        "title": "Instruction",
        "accepts": [
          "message/*",
          "text/plain",
          "application/json"
        ],
        "multiplicity": "many",
        "required": true,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "response",
        "title": "Response",
        "emits": [
          "message/*",
          "text/plain"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "raw_json",
        "title": "Raw JSON",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "model": "claude-sonnet-4-20250514",
    "api_key": "",
    "api_base_url": "https://api.anthropic.com",
    "anthropic_version": "2023-06-01",
    "system_instruction": "",
    "max_tokens": 1024,
    "temperature": "",
    "history_turns": 5,
    "timeout_sec": 120,
    "max_prompt_chars": 250000
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  }
}
